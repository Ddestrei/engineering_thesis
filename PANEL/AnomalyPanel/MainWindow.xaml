<Window x:Class="AnomalyPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel analityczny – wykrywanie anomalii w operacjach na bazie danych"
        Width="1640" Height="940" MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen" FontSize="12.5" Language="pl-PL">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Kolor wiersza według poziomu ryzyka (progi: RiskLevels w AnomalyPanel.Core). -->
        <Style x:Key="AlertRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RiskLevel}" Value="Critical">
                    <Setter Property="Background" Value="#FDE2E2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskLevel}" Value="High">
                    <Setter Property="Background" Value="#FEF0DC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskLevel}" Value="Medium">
                    <Setter Property="Background" Value="#FFF9E0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FeatureRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding OutsideUnitRange}" Value="True">
                    <Setter Property="Background" Value="#FEF0DC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Pasek stanu: wynik ostatniej operacji i pomiary czasu. -->
        <StatusBar DockPanel.Dock="Bottom" Padding="4,1">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="120" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Wybór przebiegu, modelu i sortowania; eksport. -->
        <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="10,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Przebieg:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="190" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}"
                          DisplayMemberPath="Label" Margin="0,0,14,0" />
                <TextBlock Text="Wariant:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="130" ItemsSource="{Binding Variants}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding SelectedVariant}" Margin="0,0,14,0" />
                <TextBlock Text="Detektor:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="170" ItemsSource="{Binding Detectors}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding SelectedDetector}" Margin="0,0,14,0" />
                <TextBlock Text="Sortowanie:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="170" ItemsSource="{Binding SortModes}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding SelectedSort}" Margin="0,0,14,0" />
                <Button Content="Odśwież" Command="{Binding LoadAlertsCommand}" />
                <Button Content="Eksport CSV" Command="{Binding ExportCsvCommand}" />
                <Button Content="Raport PDF" Command="{Binding ExportPdfCommand}" />
            </WrapPanel>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="6*" MinWidth="480" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="5*" MinWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- Filtry i informacje o modelu. -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <GroupBox Header="Filtry">
                        <StackPanel>
                            <TextBlock Text="Użytkownik" />
                            <ComboBox ItemsSource="{Binding UserOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding SelectedUser}" />
                            <TextBlock Text="Rola" />
                            <ComboBox ItemsSource="{Binding RoleOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding SelectedRole}" />
                            <TextBlock Text="Okna od dnia" />
                            <DatePicker SelectedDate="{Binding DateFrom}" />
                            <TextBlock Text="Okna do dnia (włącznie)" />
                            <DatePicker SelectedDate="{Binding DateTo}" />
                            <TextBlock Text="Klasa anomalii (ground truth)" />
                            <ComboBox ItemsSource="{Binding ClassOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding SelectedClass}" />
                            <TextBlock Text="Poziom ryzyka" />
                            <ComboBox ItemsSource="{Binding RiskLevelOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding MinRiskLevel}" />
                            <Button Content="Wyczyść filtry" Command="{Binding ClearFiltersCommand}"
                                    HorizontalAlignment="Left" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="W kolejce:" />
                                <Run Text="{Binding Alerts.Count, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="z" />
                                <Run Text="{Binding TotalAlerts, Mode=OneWay}" />
                                <Run Text="alertów" />
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Model, który generuje alerty">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentModel.Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                <Run Text="Hiperparametry:" />
                                <Run Text="{Binding CurrentModel.Hyperparameters, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="Liczba cech:" />
                                <Run Text="{Binding CurrentModel.FeatureCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Strojenie na VAL (Faza 6)" />
                            <TextBlock>
                                <Run Text="PR-AUC" />
                                <Run Text="{Binding CurrentModel.ValPrAuc, Mode=OneWay, StringFormat={}{0:0.000}}" />
                                <Run Text=" · MCC" />
                                <Run Text="{Binding CurrentModel.ValMainMcc, Mode=OneWay, StringFormat={}{0:0.000}}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="FPR" />
                                <Run Text="{Binding CurrentModel.ValMainFpr, Mode=OneWay, StringFormat={}{0:0.000}}" />
                                <Run Text=" · recall" />
                                <Run Text="{Binding CurrentModel.ValMainRecall, Mode=OneWay, StringFormat={}{0:0.000}}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Progi główne D7 (FPR ≤ 5% na VAL)" />
                            <ItemsControl ItemsSource="{Binding Thresholds}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding GroupKey, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=": norm ≥" />
                                            <Run Text="{Binding MainThreshold, Mode=OneWay, StringFormat={}{0:0.0000}}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Przebieg">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Okna:" />
                                <Run Text="{Binding SelectedRun.WindowCount, Mode=OneWay}" />
                                <Run Text="· anomalne:" />
                                <Run Text="{Binding SelectedRun.AnomalousWindows, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="Zdarzenia XE:" />
                                <Run Text="{Binding SelectedRun.EventCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                <Run Text="Kod:" />
                                <Run Text="{Binding SelectedRun.CodeCommit, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                <Run Text="Zamrożona konfiguracja (SHA-256):" />
                                <Run Text="{Binding SelectedRun.FrozenSha256, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Kolejka alertów. -->
            <DataGrid Grid.Column="1" ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}"
                      RowStyle="{StaticResource AlertRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="42" />
                    <DataGridTextColumn Header="Okno" Binding="{Binding WindowStart, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="106" />
                    <DataGridTextColumn Header="Użytkownik" Binding="{Binding UserId}" Width="92" />
                    <DataGridTextColumn Header="Rola" Binding="{Binding RoleId}" Width="74" />
                    <DataGridTextColumn Header="Risk" Binding="{Binding RiskScore, StringFormat={}{0:0.000}}" Width="48" />
                    <DataGridTextColumn Header="Poziom" Binding="{Binding RiskLevelLabel}" Width="62" />
                    <DataGridTextColumn Header="Norm" Binding="{Binding NormScore, StringFormat={}{0:0.000}}" Width="48" />
                    <DataGridTextColumn Header="Ground truth" Binding="{Binding GroundTruth}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="2" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Szczegóły alertu. -->
            <Grid Grid.Column="3">
                <TabControl>
                    <TabItem Header="Dlaczego alert">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <TextBlock Text="Wybierz alert z kolejki, aby zobaczyć, dlaczego powstał, i przejść do zdarzeń XE."
                                       Foreground="#6B7280" Margin="8" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Detail.HasAlert}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Detail.Error}" Foreground="#B91C1C" Margin="8,0" TextWrapping="Wrap" />
                            <StackPanel Margin="8" DataContext="{Binding Detail.Current}"
                                        Visibility="{Binding DataContext.Detail.HasAlert, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                                    <Run Text="{Binding Alert.UserId, Mode=OneWay}" />
                                    <Run Text="(" /><Run Text="{Binding Alert.RoleId, Mode=OneWay}" /><Run Text="), okno" />
                                    <Run Text="{Binding Alert.WindowStart, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                    <Run Text="–" />
                                    <Run Text="{Binding Alert.WindowEnd, Mode=OneWay, StringFormat={}{0:HH:mm}}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}">
                                    <Run Text="Operacji w oknie:" />
                                    <Run Text="{Binding Alert.OperationCount, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="RiskScore (D10) = 0,6·norm + 0,25·severity + 0,15·kontekst" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="anomaly score (norm D8)" />
                                    <TextBlock Grid.Column="1" Text="{Binding Alert.NormScore, StringFormat={}{0:0.000}}" />
                                    <TextBlock Grid.Column="2">
                                        <Run Text="wkład " /><Run Text="{Binding Alert.RiskFromScore, Mode=OneWay, StringFormat={}{0:0.000}}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Text="severity (wrażliwość danych)" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Alert.SeverityWeight, StringFormat={}{0:0.00}}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2">
                                        <Run Text="wkład " /><Run Text="{Binding Alert.RiskFromSeverity, Mode=OneWay, StringFormat={}{0:0.000}}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Text="kontekst" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Alert.ContextWeight, StringFormat={}{0:0.00}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" TextWrapping="Wrap">
                                        <Run Text="wkład " /><Run Text="{Binding Alert.RiskFromContext, Mode=OneWay, StringFormat={}{0:0.000}}" />
                                        <Run Text="(" /><Run Text="{Binding Alert.ContextText, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Text="RiskScore" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" FontWeight="SemiBold"
                                               Text="{Binding Alert.RiskScore, StringFormat={}{0:0.000}}" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Alert.RiskLevelLabel}" />
                                </Grid>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="Model i próg, które wygenerowały alert" />
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Model.Label, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=", hiperparametry" />
                                    <Run Text="{Binding Model.Hyperparameters, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Grupa progu:" />
                                    <Run Text="{Binding Alert.ThresholdGroup, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="· norm" />
                                    <Run Text="{Binding Alert.NormScore, Mode=OneWay, StringFormat={}{0:0.0000}}" />
                                    <Run Text="≥ próg główny" />
                                    <Run Text="{Binding Alert.MainThreshold, Mode=OneWay, StringFormat={}{0:0.0000}}" />
                                    <Run Text="· surowy score" />
                                    <Run Text="{Binding Alert.RawScore, Mode=OneWay, StringFormat={}{0:0.0000}}" />
                                    <Run Text="· nadwyżka ogona" />
                                    <Run Text="{Binding Alert.TailExcess, Mode=OneWay, StringFormat={}{0:0.00}}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                    <Run Text="Próg na VAL: FPR" />
                                    <Run Text="{Binding Threshold.ValFpr, Mode=OneWay, StringFormat={}{0:0.000}}" />
                                    <Run Text=", recall" />
                                    <Run Text="{Binding Threshold.ValRecall, Mode=OneWay, StringFormat={}{0:0.000}}" />
                                    <Run Text="; alarm także przy progu recall 0,8:" />
                                    <Run Text="{Binding Alert.AlarmRecall80Text, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="Cechy najbardziej odbiegające od normy (|z| robust, D12) i profil normalny z TRAIN" />
                                <DataGrid ItemsSource="{Binding DataContext.Detail.TopFeatures, RelativeSource={RelativeSource AncestorType=Window}}"
                                          RowStyle="{StaticResource FeatureRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Cecha" Binding="{Binding Feature}" Width="*" MinWidth="150" />
                                        <DataGridTextColumn Header="Grupa" Binding="{Binding GroupLabel}" Width="66" />
                                        <DataGridTextColumn Header="Wartość" Binding="{Binding Value, StringFormat={}{0:0.###}}" Width="58" />
                                        <DataGridTextColumn Header="Med. jedn." Binding="{Binding UnitMedian, StringFormat={}{0:0.###}}" Width="64" />
                                        <DataGridTextColumn Header="[P1; P99] jedn." Binding="{Binding UnitRange}" Width="100" />
                                        <DataGridTextColumn Header="Med. użytk." Binding="{Binding UserMedian, StringFormat={}{0:0.###}}" Width="68" />
                                        <DataGridTextColumn Header="|z|" Binding="{Binding RobustZ, StringFormat={}{0:0.00}}" Width="52" />
                                        <DataGridTextColumn Header="Reguła" Binding="{Binding RuleText}" Width="66" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="Jednostka = populacja (global), rola albo użytkownik zależnie od wariantu modelu. Pomarańczowe tło: wartość poza [P1; P99] okien TRAIN jednostki." />

                                <Expander Header="Wszystkie cechy okna" Margin="0,8,0,0">
                                    <DataGrid ItemsSource="{Binding Features}" RowStyle="{StaticResource FeatureRowStyle}" MaxHeight="420">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Cecha" Binding="{Binding Feature}" Width="*" MinWidth="150" />
                                            <DataGridTextColumn Header="Grupa" Binding="{Binding GroupLabel}" Width="66" />
                                            <DataGridTextColumn Header="Wartość" Binding="{Binding Value, StringFormat={}{0:0.###}}" Width="58" />
                                            <DataGridTextColumn Header="Med. jedn." Binding="{Binding UnitMedian, StringFormat={}{0:0.###}}" Width="64" />
                                            <DataGridTextColumn Header="[P1; P99] jedn." Binding="{Binding UnitRange}" Width="100" />
                                            <DataGridTextColumn Header="Med. użytk." Binding="{Binding UserMedian, StringFormat={}{0:0.###}}" Width="68" />
                                            <DataGridTextColumn Header="|z|" Binding="{Binding RobustZ, StringFormat={}{0:0.00}}" Width="52" />
                                            <DataGridTextColumn Header="Reguła" Binding="{Binding RuleText}" Width="66" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                            </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Zdarzenia XE i SQL">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run Text="Ścieżka alertu: okno → zdarzenia Extended Events (sql_batch_completed) → tekst SQL. Oryginalny eksport LOGGER-a:" />
                                <Run Text="{Binding SelectedRun.XeJsonPath, Mode=OneWay}" />
                            </TextBlock>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Detail.Events}" SelectedItem="{Binding Detail.SelectedEvent}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Czas (sym.)" Binding="{Binding SimTimestamp, StringFormat={}{0:HH:mm:ss.fff}}" Width="84" />
                                    <DataGridTextColumn Header="Operacja" Binding="{Binding OperationType}" Width="62" />
                                    <DataGridTextColumn Header="Tabela" Binding="{Binding TargetTable}" Width="*" MinWidth="120" />
                                    <DataGridTextColumn Header="Czas [µs]" Binding="{Binding DurationUs}" Width="62" />
                                    <DataGridTextColumn Header="Odczyty" Binding="{Binding LogicalReads}" Width="56" />
                                    <DataGridTextColumn Header="Wiersze" Binding="{Binding RowCount}" Width="54" />
                                    <DataGridTextColumn Header="Incydent (GT)" Binding="{Binding GtIncidentId}" Width="128" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Style="{StaticResource SectionTitle}" Text="Tekst SQL i pola zdarzenia XE" />
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Detail.SelectedSql, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto" />
                                <ScrollViewer Grid.Column="1" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto">
                                    <StackPanel DataContext="{Binding Detail.SelectedEvent}">
                                        <TextBlock><Run Text="event_uid:" /> <Run Text="{Binding EventUid, Mode=OneWay}" /></TextBlock>
                                        <TextBlock><Run Text="zdarzenie XE:" /> <Run Text="{Binding XeEventName, Mode=OneWay}" />
                                            <Run Text="#" /><Run Text="{Binding XeEventSequence, Mode=OneWay}" /></TextBlock>
                                        <TextBlock TextWrapping="Wrap"><Run Text="czas fizyczny (UTC):" /> <Run Text="{Binding PhysicalTimestamp, Mode=OneWay}" /></TextBlock>
                                        <TextBlock TextWrapping="Wrap"><Run Text="połączenie:" /> <Run Text="{Binding XeConnectionId, Mode=OneWay}" /></TextBlock>
                                        <TextBlock><Run Text="login:" /> <Run Text="{Binding LoginName, Mode=OneWay}" /></TextBlock>
                                        <TextBlock><Run Text="host:" /> <Run Text="{Binding HostName, Mode=OneWay}" /></TextBlock>
                                        <TextBlock><Run Text="urządzenie / IP:" /> <Run Text="{Binding Device, Mode=OneWay}" /> <Run Text="/" /> <Run Text="{Binding Ip, Mode=OneWay}" /></TextBlock>
                                        <TextBlock><Run Text="sesja XE (session_id):" /> <Run Text="{Binding XeSessionId, Mode=OneWay}" /></TextBlock>
                                        <TextBlock><Run Text="CPU [µs]:" /> <Run Text="{Binding CpuTimeUs, Mode=OneWay}" /></TextBlock>
                                        <TextBlock><Run Text="odczyty fizyczne:" /> <Run Text="{Binding PhysicalReads, Mode=OneWay}" /></TextBlock>
                                        <TextBlock><Run Text="zapisy:" /> <Run Text="{Binding Writes, Mode=OneWay}" /></TextBlock>
                                        <TextBlock><Run Text="wynik:" /> <Run Text="{Binding Result, Mode=OneWay}" /></TextBlock>
                                        <TextBlock><Run Text="klasa (GT):" /> <Run Text="{Binding GtAnomalyClass, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Ground truth">
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding Detail.Current.Alert.GroundTruth}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="Etykiety pochodzą z generatora scenariusza i służą tylko do oceny alertu; detektory ich nie widzą." />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Incydenty w oknie" />
                            <DataGrid ItemsSource="{Binding Detail.Incidents}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Incydent" Binding="{Binding IncidentId}" Width="150" />
                                    <DataGridTextColumn Header="Klasa" Binding="{Binding ClassLabel}" Width="160" />
                                    <DataGridTextColumn Header="Intensywność" Binding="{Binding IntensityLabel}" Width="84" />
                                    <DataGridTextColumn Header="Początek" Binding="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="128" />
                                    <DataGridTextColumn Header="Koniec" Binding="{Binding EndTime, StringFormat={}{0:HH:mm:ss}}" Width="64" />
                                    <DataGridTextColumn Header="Severity" Binding="{Binding SeverityLevel}" Width="58" />
                                    <DataGridTextColumn Header="Tabele" Binding="{Binding Tables}" Width="*" />
                                    <DataGridTextColumn Header="Operacje" Binding="{Binding Operations}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Pomiary czasu">
                        <DockPanel Margin="8">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="Ostatnie ładowanie kolejki:" />
                                    <Run Text="{Binding LastLoadMs, Mode=OneWay, StringFormat={}{0:0} ms}" FontWeight="SemiBold" />
                                    <Run Text="(w tym SQL" />
                                    <Run Text="{Binding LastSqlMs, Mode=OneWay, StringFormat={}{0:0} ms}" />
                                    <Run Text=") · filtrowanie" />
                                    <Run Text="{Binding LastFilterMs, Mode=OneWay, StringFormat={}{0:0.0} ms}" />
                                </TextBlock>
                                <Button Content="Eksport pomiarów CSV" Command="{Binding ExportTimingsCommand}" Margin="12,0,0,0" />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Timings}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Czas" Binding="{Binding At, StringFormat={}{0:HH:mm:ss.fff}}" Width="90" />
                                    <DataGridTextColumn Header="Operacja" Binding="{Binding Operation}" Width="*" />
                                    <DataGridTextColumn Header="ms" Binding="{Binding Milliseconds, StringFormat={}{0:0.0}}" Width="70" />
                                    <DataGridTextColumn Header="Wiersze" Binding="{Binding Rows}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
