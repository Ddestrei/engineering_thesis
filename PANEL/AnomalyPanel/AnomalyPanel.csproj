<Project Sdk="Microsoft.NET.Sdk">

  <!-- Panel analityczny WPF (Faza 8): warstwa prezentacji nad bazą AnomalyResults. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AnomalyPanel</RootNamespace>
    <AssemblyName>AnomalyPanel</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnomalyPanel.Core\AnomalyPanel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
